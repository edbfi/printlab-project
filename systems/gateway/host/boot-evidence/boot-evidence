#!/usr/bin/python3 -I
"""Write one evidence line per boot: how the previous boot ended and how long
the school Wi-Fi login and the VPN tunnel took to come up, plus native eligibility.

Runs at every boot from printing-boot-evidence.service. The current boot is
recorded once the VPN boot check passed (or historical WLAN auth and tunnel
readiness both exist) and the clock is synced, or
after DEADLINE. Earlier boots that ended before they were recorded are
backfilled from the persistent journal and marked recorded=late. All timings
are journal monotonic seconds since kernel start, so they are right even
before NTP sync.
"""

import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime

LOG = "/var/log/printing-station/boot-evidence.log"
STATE = "/var/lib/printing-station/boot-evidence.recorded"
DEADLINE = 1800  # seconds since boot to wait for the current boot
POLL = 5
BACKFILL_MAX = 10
SLOW_AUTH = 120  # wlan0 auth later than this is logged as a warning
SLOW_TUNNEL = 180

CLEAN_END = r"Reached target .*(reboot|poweroff|halt|kexec)\.target"
TRIGGER = (r"COMMAND=.*(reboot|shutdown|poweroff)|System is (rebooting|powering)"
           r"|Power key|[Rr]ebooting")


def journal(boot, *args):
    out = subprocess.run(
        ["journalctl", "-b", boot, "-o", "json", "-q", "--no-pager", *args],
        capture_output=True, text=True, check=False).stdout
    return [json.loads(line) for line in out.splitlines() if line.startswith("{")]


def mono(entry):
    return int(entry["__MONOTONIC_TIMESTAMP"]) // 1_000_000


def real(entry):
    return int(entry["__REALTIME_TIMESTAMP"]) // 1_000_000


def stamp(epoch):
    return datetime.fromtimestamp(epoch).strftime("%F %T")


def find(boot, ident, pattern):
    """Oldest entry from ident matching pattern in this boot, or None."""
    hits = journal(boot, "-t", ident, "-g", pattern)
    return hits[0] if hits else None


def boot_start(boot):
    """Wall-clock boot time, if the clock was synced during that boot."""
    sync = find(boot, "systemd-timesyncd", "Initial clock synchronization")
    return (real(sync) - mono(sync), mono(sync)) if sync else (None, None)


def network(boot):
    auth = find(boot, "wpa_supplicant", "CTRL-EVENT-CONNECTED")
    tunnel = find(boot, "helper", "Initialization Sequence Completed")
    rejects = [e for e in journal(boot, "-t", "wpa_supplicant", "-g",
                                  "CTRL-EVENT-DISCONNECTED .*reason=23")
               if auth is None or mono(e) < mono(auth)]
    return (mono(auth) if auth else None, len(rejects),
            mono(tunnel) if tunnel else None)


def uplink_boot(boot):
    hits = journal(boot, "-u", "printing-uplink-boot-check.service", "-g",
                   "^Verified boot transport: (enp1s0|wlan0)$")
    if not hits:
        return None, None
    entry = hits[0]
    return mono(entry), entry.get("MESSAGE", "").rsplit(": ", 1)[-1]


def ending(boot):
    """How the boot ended, judged from its own journal."""
    last = journal(boot, "-n", "1")
    if not last:
        return {"ending": "unknown"}
    info = {"lived": f"{mono(last[0])}s"}
    if journal(boot, "_PID=1", "-g", CLEAN_END, "-n", "1"):
        info["ending"] = "clean"
        # A sudo command names who asked; logind only says it happened.
        hit = (journal(boot, "-t", "sudo", "-g", TRIGGER, "-n", "1") or
               journal(boot, "-t", "systemd-logind", "-t", "unattended-upgrade",
                       "-g", TRIGGER, "-n", "1"))
        if hit:
            msg = hit[0].get("MESSAGE", "")
            if " COMMAND=" in msg:
                msg = f"sudo {msg.split(' : ')[0].strip()}: {msg.split('COMMAND=', 1)[1]}"
            info["trigger"] = f'"{msg[:120]}"'
    else:
        info["ending"] = "unclean"
        info["trigger"] = '"power loss, kernel hang or watchdog reset"'
    info["last_entry_epoch"] = real(last[0])
    info["synced"] = boot_start(boot)[0] is not None
    return info


def describe(boots, idx, live):
    boot = boots[idx]["boot_id"]
    start, sync_at = boot_start(boot)
    auth, rejects, tunnel = network(boot)
    uplink_at, uplink = uplink_boot(boot)
    fields = {
        "boot": stamp(start) if start else "unknown",
        "boot_id": boot[:8],
        "wlan0_auth": f"+{auth}s" if auth is not None else "none",
        "eap_rejects": str(rejects),
        "uplink_verified": f"+{uplink_at}s" if uplink_at is not None else "none",
        "uplink": uplink or "unverified",
        "tun0_up": f"+{tunnel}s" if tunnel is not None else "none",
        "clock_sync": f"+{sync_at}s" if sync_at is not None else "none",
    }
    if idx > 0:
        prev = ending(boots[idx - 1]["boot_id"])
        fields["prev_ending"] = prev["ending"]
        if "trigger" in prev:
            fields["prev_trigger"] = prev["trigger"]
        fields["prev_lived"] = prev.get("lived", "unknown")
        if start and prev.get("synced"):
            fields["downtime"] = f"{start - prev['last_entry_epoch']}s"
        else:
            fields["downtime"] = "unknown"
    else:
        fields["prev_ending"] = "unknown (not in persistent journal)"
    if live:
        def addr(dev):
            out = subprocess.run(["ip", "-4", "-o", "addr", "show", "dev", dev],
                                 capture_output=True, text=True, check=False).stdout
            match = re.search(r"inet (\S+)", out)
            return match.group(1) if match else "down"
        try:
            with open("/sys/class/watchdog/watchdog0/bootstatus") as fh:
                fields["watchdog_bootstatus"] = fh.read().strip()
        except OSError:
            fields["watchdog_bootstatus"] = "n/a"
        fields["enp1s0"] = addr("enp1s0")
        fields["wlan0"] = addr("wlan0")
        fields["tun0"] = addr("tun0")
    else:
        fields["recorded"] = "late"
    slow = ((uplink_at > SLOW_TUNNEL) if uplink_at is not None else
            (auth is None or auth > SLOW_AUTH or tunnel is None or tunnel > SLOW_TUNNEL))
    return " ".join(f"{k}={v}" for k, v in fields.items()), slow


def emit(line, slow):
    # <4> is journald's warning priority; slow recoveries stand out in -p warning.
    print(f"<4>{line} slow=yes" if slow else f"<6>{line}", flush=True)
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    with open(LOG, "a") as fh:
        fh.write(f"{stamp(time.time())} {line}{' slow=yes' if slow else ''}\n")


def mark(boot):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, "a") as fh:
        fh.write(boot + "\n")


def main():
    boots = json.loads(subprocess.run(
        ["journalctl", "--list-boots", "-o", "json", "--no-pager"],
        capture_output=True, text=True, check=True).stdout)
    current = boots[-1]["boot_id"]
    try:
        with open(STATE) as fh:
            recorded = set(fh.read().split())
    except FileNotFoundError:
        recorded = set()

    for idx in range(max(0, len(boots) - 1 - BACKFILL_MAX), len(boots) - 1):
        if boots[idx]["boot_id"] not in recorded:
            emit(*describe(boots, idx, live=False))
            mark(boots[idx]["boot_id"])

    if current in recorded:
        return 0
    while True:
        uptime = float(open("/proc/uptime").read().split()[0])
        auth, _, tunnel = network(current)
        synced = boot_start(current)[0] is not None
        uplink_at, _ = uplink_boot(current)
        native_boot = os.path.exists("/var/lib/printing-station/rollback/native-uplink-trial/boot-enabled")
        ready = uplink_at is not None or (not native_boot and auth is not None and tunnel is not None)
        if (ready and synced) or uptime >= DEADLINE:
            break
        time.sleep(POLL)
    emit(*describe(boots, len(boots) - 1, live=True))
    mark(current)
    return 0


if __name__ == "__main__":
    sys.exit(main())
