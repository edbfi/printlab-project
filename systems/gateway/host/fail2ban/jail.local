[sshd]
enabled = true
backend = systemd
journalmatch = _SYSTEMD_UNIT=ssh.service + _COMM=sshd
filter = sshd[mode=normal, publickey=nofail]
port = 22
protocol = tcp

# Five failures within ten minutes ban an address for an hour.
maxretry = 5
findtime = 10m
bantime = 1h

# Repeat bans double, up to seven days. fail2ban.local keeps ban history for 30 days.
bantime.increment = true
bantime.factor = 1
bantime.multipliers = 1 2 4 8 16 32 64 128 168
bantime.maxtime = 7d
bantime.overalljails = false

banaction = nftables
action = %(action_)s
# Only loopback is exempt; an administrator's address can be banned.
ignoreip = 127.0.0.1/8 ::1

[sshd-aggressive]
enabled = false

[sshd-badprotocol]
enabled = false

[sshd-ddos]
enabled = false

[recidive]
enabled = false
